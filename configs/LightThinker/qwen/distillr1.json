{
    "template": {
        "model": "qwen",
        "prefix": "",
        "middle": "<｜User｜>",
        "suffix": "<｜Assistant｜>",
        "complete": "{system}<｜User｜>{question}<｜Assistant｜>"
    },
    "prompt": {
